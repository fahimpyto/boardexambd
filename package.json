{
  "name": "boardexambd",
  "version": "2.0.0",
  "private": true,
  "description": "Static SSC, HSC and university admission guides for Bangladesh.",
  "scripts": {
    "build:css": "tailwindcss -i ./assets/css/input.css -o ./assets/css/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./assets/css/input.css -o ./assets/css/tailwind.css --watch",
    "build:site": "python tools/build_site.py",
    "stage": "python tools/stage_site.py",
    "build": "npm run build:site && npm run build:css && npm run stage",
    "serve": "python -m http.server 8080",
    "serve:dist": "python -m http.server 8080 --directory dist"
  },
  "devDependencies": {
    "tailwindcss": "3.4.17"
  }
}
