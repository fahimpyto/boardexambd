{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "boardexambd",
  "main": "./worker.js",
  "compatibility_date": "2026-10-26",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/*.html", "/*/", "/index"]
  }
}
